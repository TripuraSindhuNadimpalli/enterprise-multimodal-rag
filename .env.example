# Application
APP_NAME=Enterprise Multimodal RAG
APP_VERSION=0.1.0
ENVIRONMENT=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=55433
POSTGRES_DB=enterprise_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=enterprise-documents
MINIO_SECURE=false

# JWT
# Replace this with a strong secret in your real .env file.
JWT_SECRET_KEY=replace-with-a-secure-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60

# CORS
# For cloud deployment, replace/add your deployed frontend URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Frontend
# For cloud deployment, set this to the public backend URL.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434